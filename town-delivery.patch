+                            checked={selected}
+                            onChange={(event) => {
+                              if (event.target.checked) {
+                                setDeliveryRegions((current) => [...current, region]);
+                              } else {
+                                setDeliveryRegions((current) =>
+                                  current.filter((item) => item !== region),
+                                );
+                                setDeliveryAreas((current) => {
